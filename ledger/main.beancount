# Option principale de la comptabilité du foyer.
# Les includes sont des globs par année ou par type : ni la GUI ni les outils
# n'ont jamais besoin d'éditer ce fichier pour créer un fichier mensuel ou une
# année de budget (le loader rustledger garantit un ordre de résolution déterministe).
option "title" "Comptabilité du foyer"
option "operating_currency" "EUR"

include "commodities.beancount"
include "accounts.beancount"
include "budgets/2026.beancount"
include "transactions/2025/*.beancount"
include "transactions/2026/*.beancount"
